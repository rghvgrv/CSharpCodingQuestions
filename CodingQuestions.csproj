<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);web/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Each question's source file is embedded so the UI shows the exact code that ran. -->
    <EmbeddedResource Include="Questions/**/*.cs;Lib.cs" LogicalName="%(Filename)" />
    <Using Include="System.Text" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Collections.Concurrent" />
    <Using Include="System.Threading.Channels" />
    <Using Include="CodingQuestions" />
    <Using Include="CodingQuestions.Lib" Static="true" />
    <Using Include="CodingQuestions.Level" Static="true" />
  </ItemGroup>

  <!-- First `dotnet run` builds the React UI into wwwroot. Rebuild UI: cd web && npm run build -->
  <Target Name="BuildWeb" BeforeTargets="Build" Condition="!Exists('wwwroot/index.html')">
    <Exec WorkingDirectory="web" Command="npm install" />
    <Exec WorkingDirectory="web" Command="npm run build" />
  </Target>

</Project>
